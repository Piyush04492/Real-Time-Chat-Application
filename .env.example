# Database Configuration
# Use SQLite by default for easy running:
DATABASE_URL=sqlite:///./chat.db
# To use MySQL (Level 2/5):
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/chat_db

# Security
SECRET_KEY=supersecretjwtkeyforrealtimechatapplication12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Redis configuration (for scaling WebSockets - Level 5)
# REDIS_URL=redis://localhost:6379/0
